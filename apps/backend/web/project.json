{
  "name": "backend-web",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/backend/web/src",
  "projectType": "application",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@nx/webpack:webpack",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "options": {
        "target": "node",
        "compiler": "tsc",
        "outputPath": "dist/apps/backend/web",
        "main": "apps/backend/web/src/main.ts",
        "tsConfig": "apps/backend/web/tsconfig.app.json",
        "webpackConfig": "apps/backend/web/webpack.config.js",
        "generatePackageJson": true,
        "sourceMap": true,
        "outputHashing": "none",
        "optimization": false
      },
      "configurations": {
        "development": {},
        "production": {}
      }
    },
    "prune-lockfile": {
      "dependsOn": ["build"],
      "cache": true,
      "executor": "@nx/js:prune-lockfile",
      "outputs": [
        "{workspaceRoot}/dist/apps/backend/web/package.json",
        "{workspaceRoot}/dist/apps/backend/web/pnpm-lock.yaml"
      ],
      "options": {
        "buildTarget": "build"
      }
    },
    "copy-workspace-modules": {
      "dependsOn": ["build"],
      "cache": true,
      "outputs": ["{workspaceRoot}/dist/apps/backend/web/workspace_modules"],
      "executor": "@nx/js:copy-workspace-modules",
      "options": {
        "buildTarget": "build"
      }
    },
    "prune": {
      "dependsOn": ["prune-lockfile", "copy-workspace-modules"],
      "executor": "nx:noop"
    },
    "serve": {
      "continuous": true,
      "executor": "@nx/js:node",
      "defaultConfiguration": "development",
      "dependsOn": ["build"],
      "options": {
        "buildTarget": "backend-web:build"
      },
      "configurations": {
        "development": {
          "buildTarget": "backend-web:build:development"
        },
        "production": {
          "buildTarget": "backend-web:build:production"
        }
      }
    },
    "test": {
      "options": {
        "passWithNoTests": true
      }
    },
    "schema-generate": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "production",
        "^production",
        "{workspaceRoot}/tsconfig.schema-generate.json"
      ],
      "outputs": ["{projectRoot}/output/schema.graphql"],
      "options": {
        "command": "npx ts-node -r tsconfig-paths/register --project tsconfig.schema-generate.json apps/backend/web/scripts/generate-graphql-schema.ts"
      }
    }
  }
}
